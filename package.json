{
  "name": "vue3-dashboard-light",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "run-p type-check \"test-only {@}\" --",
    "pre": "run-p type-check \"pre-only {@}\" --",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test-only": "vite build --mode test",
    "pre-only": "vite build --mode staging",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@kjgl77/datav-vue3": "^1.7.4",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "gsap": "^3.15.0",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=8.19.4"
  }
}
